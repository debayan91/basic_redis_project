# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threat_intel_db
POSTGRES_USER=threat_user
POSTGRES_PASSWORD=threat_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=2.0

# Cache TTL Configuration (in seconds)
CACHE_TTL_MALICIOUS=86400    # 24 hours
CACHE_TTL_SUSPICIOUS=14400   # 4 hours
CACHE_TTL_BENIGN=3600        # 1 hour
CACHE_TTL_UNKNOWN=600        # 10 minutes

# Alerting & Pipeline
HIGH_RISK_THRESHOLD=75       # Scores >= 75 trigger high-risk alerts
ALERTS_PUBSUB_CHANNEL=threat:alerts:high_risk

# External CTI Provider
MOCK_EXTERNAL_CTI=true
EXTERNAL_CTI_API_KEY=
