# Application
PROJECT_NAME="Real-Time Threat Intelligence Cache"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=threat_intel_db
POSTGRES_USER=threat_user
POSTGRES_PASSWORD=threat_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=2.0

# Threat Intelligence Provider Configuration
CTI_PROVIDER=local
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
EXTERNAL_CTI_TIMEOUT=3.0
EXTERNAL_CTI_MAX_RETRIES=2

# Operational Alerts & Security Policies
ALERT_THRESHOLD=70
AUTO_BLACKLIST_THRESHOLD=85
REDIS_PUBSUB_CHANNEL=malicious_indicator_detected

